# Copy to .env for local use; set the same names in Vercel > Project > Settings > Environment Variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lunar_ice_watch
# Signs login cookies. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vercel dashboard > Storage > Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=
